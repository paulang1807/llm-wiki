{
  "name": "llm-wiki",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "package:mac": "npm run build && node scripts/build-mac.js && electron-builder --mac",
    "electron:dev": "electron ."
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.0.2",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.paulang.llmwiki",
    "productName": "LLM Wiki",
    "asar": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    }
  }
}
